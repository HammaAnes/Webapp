# ============================================================
# COFFICE — Exemple de configuration (.env.example)
# Copier ce fichier en .env et remplir les valeurs réelles.
# NE JAMAIS commiter le fichier .env (il est dans .gitignore)
# ============================================================


# ------------------------------------------------------------
# FRONTEND (Vite) — seules les variables VITE_* sont exposées
# ------------------------------------------------------------

# Google Tag Manager — ID conteneur (format GTM-XXXXXXX)
# Le conteneur GTM gère GA4 et tous les autres tags depuis l'interface GTM
# ID hardcodé dans index.html : GTM-WF4LGQ63


# URL complète de l'API PHP backend
# Production  : https://coffice.dz/api
# Local XAMPP : http://localhost/coffice-webapp/api
# Local Valet : http://coffice.test/api
VITE_API_URL=https://coffice.dz/api


# ------------------------------------------------------------
# BACKEND PHP — variables lues par api/.env ou .env à la racine
# ------------------------------------------------------------

# Environnement : "production" | "development"
# En development, les erreurs PHP s'affichent et le CORS est ouvert
APP_ENV=production

# URL publique de l'application (utilisée dans les emails)
APP_URL=https://coffice.dz


# --- Base de données MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cofficed_coffice
DB_USER=cofficed_user
DB_PASSWORD=
DB_CHARSET=utf8mb4


# --- JWT ---
# Clé secrète pour signer les tokens — doit être longue et aléatoire
# Générer avec : openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_A_STRONG_SECRET


# --- Email transactionnel via Brevo (ex-Sendinblue) ---
# Obligatoire pour l'envoi d'emails (confirmations, rappels, etc.)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=desk@coffice.dz
BREVO_SENDER_NAME=Coffice
BREVO_WEBHOOK_SECRET=

# Mailer fallback (smtp ou "log" pour désactiver les envois en local)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=desk@coffice.dz
MAIL_FROM_NAME=Coffice
MAIL_ADMIN=desk@coffice.dz
MAIL_VERIFY_SSL=true


# --- Google OAuth ---
# Obtenir sur console.cloud.google.com
GOOGLE_CLIENT_ID=


# --- Rate limiting ---
RATE_LIMIT_MAX_ATTEMPTS=60
RATE_LIMIT_DECAY_MINUTES=1


# --- Upload ---
# Taille max des fichiers uploadés (en octets) — 10 Mo par défaut
UPLOAD_MAX_SIZE=10485760
